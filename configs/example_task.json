{
  "device": {
    "adb_path": "127.0.0.1:5555",
    "screenshot_quality": 30,
    "screencap_method": "fast",
    "input_method": "adb"
  },
  "targets": [
    {
      "target_id": "search_bar",
      "type": "template",
      "image_path": "search_bar.png",
      "roi": null,
      "threshold": 0.8
    },
    {
      "target_id": "text_搜索",
      "type": "ocr",
      "text": "搜索",
      "roi": null,
      "threshold": 0.5
    },
    {
      "target_id": "close_button",
      "type": "template",
      "image_path": "close_btn.png",
      "roi": null,
      "threshold": 0.75
    },
    {
      "target_id": "screen_bottom",
      "type": "coordinate",
      "roi": [0, 1800, 1080, 200],
      "threshold": 1.0
    }
  ],
  "tasks": [
    {
      "task_name": "打开搜索框",
      "trigger": "manual",
      "steps": [
        {
          "action": "wait_target",
          "target_id": "search_bar",
          "timeout_ms": 8000,
          "max_retries": 8,
          "retry_interval_ms": 1000
        },
        {
          "action": "tap",
          "target_id": "search_bar",
          "wait_after_ms": 1500
        },
        {
          "action": "input_text",
          "text": "今天天气怎么样",
          "wait_after_ms": 500
        },
        {
          "action": "key_event",
          "keycode": 66,
          "wait_after_ms": 3000
        }
      ]
    },
    {
      "task_name": "关闭弹窗",
      "trigger": "on_start",
      "steps": [
        {
          "action": "wait_target",
          "target_id": "close_button",
          "timeout_ms": 3000,
          "max_retries": 3,
          "retry_interval_ms": 1000
        },
        {
          "action": "tap",
          "target_id": "close_button",
          "wait_before_ms": 200,
          "wait_after_ms": 500
        }
      ]
    },
    {
      "task_name": "向下翻页",
      "trigger": "manual",
      "steps": [
        {
          "action": "swipe",
          "start_coord": [540, 1500],
          "end_coord": [540, 500],
          "duration_ms": 400,
          "wait_after_ms": 1000
        },
        {
          "action": "swipe",
          "start_coord": [540, 1500],
          "end_coord": [540, 500],
          "duration_ms": 400,
          "wait_after_ms": 1000
        }
      ]
    }
  ]
}
